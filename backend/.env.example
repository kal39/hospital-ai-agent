APP_NAME=Hospital AI Assistant API
APP_VERSION=0.1.0
ENVIRONMENT=development
PORT=5000
FRONTEND_ORIGIN=

# Comma-separated backend host allowlist.
# Local development defaults; replace with actual backend hostnames in production.
# Example production value: TRUSTED_HOSTS=api.example.org,portal.example.org
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# Development-only authentication for synthetic patients
DEMO_AUTH_ENABLED=true

# Gemini configuration
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest
LLM_FALLBACK_MODEL=gemini-flash-latest

MAX_MESSAGE_LENGTH=2000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
