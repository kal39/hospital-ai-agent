APP_NAME=Hospital AI Assistant API
APP_VERSION=0.1.0
ENVIRONMENT=development
PORT=5000
FRONTEND_ORIGIN=

# Comma-separated backend host allowlist.
# Local development defaults; replace with actual backend hostnames in production.
# Example production value: TRUSTED_HOSTS=api.example.org,portal.example.org
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# Development-only authentication for synthetic patients
DEMO_AUTH_ENABLED=true

# Gemini configuration
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest
LLM_FALLBACK_MODEL=gemini-flash-latest

MAX_MESSAGE_LENGTH=2000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Verified hospital emergency contacts.
# Leave blank until the hospital confirms the correct contact information.
HOSPITAL_NAME=
HOSPITAL_EMERGENCY_PHONE=
AMBULANCE_DISPATCH_PHONE=
ALTERNATIVE_EMERGENCY_PHONE=
HOSPITAL_ADDRESS=
EMERGENCY_DIRECTIONS=


# External notification delivery.
# Keep disabled until real providers and dedicated test recipients are configured.
# Never use synthetic patient records as outbound recipient addresses/numbers.
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_PROVIDER=
NOTIFICATION_EMAIL_API_KEY=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_TEST_EMAIL=

NOTIFICATION_SMS_ENABLED=false
# Use 'sample' only for local simulation; it never sends real SMS.
NOTIFICATION_SMS_PROVIDER=sample
NOTIFICATION_SMS_API_KEY=
NOTIFICATION_SMS_SENDER_ID=
NOTIFICATION_TEST_PHONE=
